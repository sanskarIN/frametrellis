#include <winver.h>

IDI_ICON1 ICON "frametrellis.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION FT_VERSION_MAJOR,FT_VERSION_MINOR,FT_VERSION_PATCH,0
PRODUCTVERSION FT_VERSION_MAJOR,FT_VERSION_MINOR,FT_VERSION_PATCH,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "FrameTrellis contributors"
      VALUE "FileDescription", "FrameTrellis video editor"
      VALUE "FileVersion", FT_VERSION_STRING
      VALUE "InternalName", "frametrellis"
      VALUE "LegalCopyright", "Copyright (C) 2026 Sanskar and FrameTrellis contributors. GPL-3.0-or-later."
      VALUE "OriginalFilename", "frametrellis.exe"
      VALUE "ProductName", "FrameTrellis"
      VALUE "ProductVersion", FT_VERSION_STRING
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
